; Engine configuration file.
config_version=5

[application]

config/name="BeamNG.Earth"
config/description="Driving in the real world, Minsk first."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=0

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_touch_from_mouse=false

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=12
3d/default_gravity=9.81
jolt_physics_3d/simulation/allow_sleep=false

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/default_filters/anisotropic_filtering_level=3
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
environment/defaults/default_clear_color=Color(0.55, 0.68, 0.82, 1)
anti_aliasing/quality/use_debanding=true

[shader_globals]

night={
"type": "float",
"value": 0.0
}
wetness={
"type": "float",
"value": 0.0
}
detail_center={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
detail_radius={
"type": "float",
"value": 0.0
}
biome={
"type": "float",
"value": 0.0
}
signal_time={
"type": "float",
"value": 0.0
}
